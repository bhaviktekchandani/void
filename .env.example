# VOID Bot Environment Variables
# Copy this file to .env and configure with your credentials.

# Discord Bot Token (from Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID (from Discord Developer Portal > General Information)
CLIENT_ID=your_discord_application_id_here

# Development Server ID (Optional: registers slash commands instantly to this guild)
GUILD_ID=your_test_guild_id_here

# PostgreSQL Connection String (Provided automatically by Railway PostgreSQL or locally)
DATABASE_URL=postgresql://postgres:password@localhost:5432/void

# Logging Verbosity: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
